"""Use cases against the SQL adapter, without HTTP."""

from collections.abc import Iterator
from pathlib import Path

import pytest

from {{ package_name }}.application.examples import ExampleService
from {{ package_name }}.domain.examples import ExampleNotFoundError
from {{ package_name }}.infrastructure.sql import SqlExampleRepository


@pytest.fixture
def repository(tmp_path: Path) -> Iterator[SqlExampleRepository]:
    """A repository over a private SQLite file with its tables created."""
    store = SqlExampleRepository(f"sqlite:///{(tmp_path / 'unit.db').as_posix()}")
    store.create_tables()
    yield store
    store.dispose()


def test_created_example_can_be_read(repository: SqlExampleRepository) -> None:
    service = ExampleService(repository)

    created = service.create("alpha", "first")

    assert service.get(created.id) == created


def test_missing_example_raises(repository: SqlExampleRepository) -> None:
    service = ExampleService(repository)

    with pytest.raises(ExampleNotFoundError):
        service.get(1)


def test_deleting_a_missing_example_raises(repository: SqlExampleRepository) -> None:
    service = ExampleService(repository)

    with pytest.raises(ExampleNotFoundError):
        service.delete(1)


def test_page_respects_offset_and_limit(repository: SqlExampleRepository) -> None:
    service = ExampleService(repository)
    for name in ["a", "b", "c"]:
        service.create(name, "x")

    assert [item.name for item in service.page(offset=1, limit=1)] == ["b"]
