"""The SQL adapter end to end: tables exist at startup, and data survives a restart."""

from pathlib import Path

from fastapi.testclient import TestClient
from pydantic import SecretStr

from {{ package_name }}.app import create_app
from {{ package_name }}.settings import Settings


def _settings(database: Path) -> Settings:
    return Settings(
        _env_file=None,
        ENVIRONMENT="test",
        LOG_FORMAT="text",
        ALLOWED_HOSTS=["testserver"],
        DATABASE_URL=SecretStr(f"sqlite:///{database.as_posix()}"),
    )


def test_tables_are_created_at_startup(tmp_path: Path) -> None:
    database = tmp_path / "service.db"

    with TestClient(create_app(_settings(database))) as client:
        assert client.get("/api/v1/examples").json() == []

    assert database.exists()


def test_examples_survive_a_restart(tmp_path: Path) -> None:
    settings = _settings(tmp_path / "service.db")
    with TestClient(create_app(settings)) as client:
        created = client.post("/api/v1/examples", json={"name": "kept", "description": "stored"})
        example_id = created.json()["id"]

    with TestClient(create_app(settings)) as client:
        assert client.get(f"/api/v1/examples/{example_id}").json()["name"] == "kept"


def test_readiness_checks_the_database(tmp_path: Path) -> None:
    with TestClient(create_app(_settings(tmp_path / "service.db"))) as client:
        response = client.get("/ready")

    assert response.json() == {"status": "ok", "checks": {"database": "ok"}}
