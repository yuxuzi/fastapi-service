# Copy to .env for local values. Never commit .env; production values come from the environment.
{{ package_name | upper }}_ENVIRONMENT=development
{{ package_name | upper }}_LOG_FORMAT=json
{{ package_name | upper }}_ALLOWED_HOSTS=["localhost","127.0.0.1"]
# SQLAlchemy URL. Keep a PostgreSQL password out of this file and out of git.
{{ package_name | upper }}_DATABASE_URL=sqlite:///./{{ project_name }}.db
