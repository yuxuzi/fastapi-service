"""HTTP behaviour: health, readiness, the example resource, and errors."""

from fastapi import FastAPI
from fastapi.testclient import TestClient


def test_health_reports_ok(client: TestClient) -> None:
    response = client.get("/health")

    assert response.status_code == 200
    assert response.json()["status"] == "ok"


def test_ready_passes_without_checks(client: TestClient) -> None:
    response = client.get("/ready")

    assert response.status_code == 200
    assert response.json() == {"status": "ok", "checks": {}}


def test_failing_readiness_check_returns_503(app: FastAPI, client: TestClient) -> None:
    def broken() -> None:
        raise RuntimeError("dependency is down")

    app.state.readiness_checks["broken"] = broken

    response = client.get("/ready")

    assert response.status_code == 503
    assert response.json() == {"status": "unavailable", "checks": {"broken": "failed"}}


def test_example_lifecycle(client: TestClient) -> None:
    created = client.post("/api/v1/examples", json={"name": "alpha", "description": "first"})
    assert created.status_code == 201
    example_id = created.json()["id"]

    fetched = client.get(f"/api/v1/examples/{example_id}")
    assert fetched.json() == {"id": example_id, "name": "alpha", "description": "first"}

    listed = client.get("/api/v1/examples")
    assert [item["id"] for item in listed.json()] == [example_id]

    assert client.delete(f"/api/v1/examples/{example_id}").status_code == 204
    assert client.get(f"/api/v1/examples/{example_id}").status_code == 404


def test_missing_example_is_404(client: TestClient) -> None:
    response = client.get("/api/v1/examples/999")

    assert response.status_code == 404
    assert "999" in response.json()["detail"]


def test_empty_name_is_rejected(client: TestClient) -> None:
    response = client.post("/api/v1/examples", json={"name": "", "description": "x"})

    assert response.status_code == 422


def test_request_id_is_echoed_back(client: TestClient) -> None:
    response = client.get("/health", headers={"X-Request-ID": "trace-42"})

    assert response.headers["X-Request-ID"] == "trace-42"


def test_unlisted_host_is_rejected(client: TestClient) -> None:
    response = client.get("/health", headers={"Host": "evil.example"})

    assert response.status_code == 400
